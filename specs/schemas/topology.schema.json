    "enforced_by": "scripts/validate_contract.py",
    "json_schema_support": "annotation_only",
    "normalization": "lowercase_alphanumeric",
    "pii_direct_stems": [
      "customer",
      "email",
      "gpsi",
      "imei",
      "imsi",
      "msisdn",
      "phone",
      "subscriber",
      "supi"
    ],
    "pii_unordered_groups": [
